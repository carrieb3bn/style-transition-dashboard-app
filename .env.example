# Your store's myshopify domain, no protocol
SHOPIFY_STORE_DOMAIN=three-bird-nest.myshopify.com

# Admin API access token from a custom app
# Required scopes: read_products, read_orders, read_inventory
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version to target
SHOPIFY_API_VERSION=2024-10
